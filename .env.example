# ---- SMTP (your personal email account) ----
# Gmail:   SMTP_HOST=smtp.gmail.com   SMTP_PORT=465 (SSL) or 587 (STARTTLS)
# Outlook: SMTP_HOST=smtp.office365.com SMTP_PORT=587
# Zoho:    SMTP_HOST=smtp.zoho.com    SMTP_PORT=465
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
# Use an App Password here if your provider requires one (Gmail, Yahoo, iCloud, Zoho with 2FA).
SMTP_PASSWORD=
# The "From" address. Plain address or with a display name, e.g. "Your Name <you@gmail.com>"
FROM_EMAIL="Your Name <you@gmail.com>"

# ---- Login ----
# Login for both the send page and the configuration page
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Optional ----
# NODE_ENV=production   # hides backend error details from the UI
# RESUME_FILENAME=Your_Name_Resume.pdf   # attachment name the recipient sees
